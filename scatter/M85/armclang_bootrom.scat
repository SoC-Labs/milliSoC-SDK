LOAD 0xFFFF0000
{
    CODE 0xFFFF0000
    {
        r5_startup.o(VECTORS,+FIRST)
        *(InRoot$$Sections)
        .ANY (+RO)
    }

    DATA 0x20000000 0x2000
    {
        * (+RW,+ZI)                         ; All RW and ZI Data
    }

    ARM_LIB_STACKHEAP 0x20002000 EMPTY 0x2000   ; Stack and heap 
    {
    }
}
